{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
    "App Store",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
      "zh-Hans",
    ],
  },
  "packages": [
    {
      "kind": "local",
      "path": "Upstream/Fotufilm",
    },
  ],
  "files": [
    { "kind": "folder", "path": "Hibiscus Film", "target-membership": [ "Hibiscus Film" ] },
    { "kind": "folder", "path": "StoreKit" },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Hibiscus Film.app", "id": "7CC71D7D30B292AE0082980E", "type": "wrapper.application", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "Hibiscus Film",
      "id": "7CC71D7C30B292AE0082980E",
      "product": "Products/Hibiscus Film.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "Fotufilm",
          "product-name": "FotufilmMetal",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "Hibiscus Spatial Icon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "1",
        "DEVELOPMENT_TEAM": "X4CQDB35NV",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.photography",
        "INFOPLIST_KEY_NSCameraUsageDescription": "Use the camera to take photos with the selected film profile.",
        "INFOPLIST_KEY_NSMicrophoneUsageDescription": "Record sound with Live Photos.",
        "INFOPLIST_KEY_NSPhotoLibraryAddUsageDescription": "Save your captured photograph to Photos.",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationPortrait",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown",
        "IPHONEOS_DEPLOYMENT_TARGET": "18.0",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "MARKETING_VERSION": "1.0.0",
        "MTLLINKER_FLAGS": "$(inherited) -fcikernel",
        "MTL_COMPILER_FLAGS": "$(inherited) -fcikernel",
        "PRODUCT_BUNDLE_IDENTIFIER": "dev.1234567890.HibiscusFilm",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1",
      },
    },
  ],
  "build-settings": {
    "ALWAYS_SEARCH_USER_PATHS": "NO",
